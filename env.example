# Client-side public keys (do not put secrets here)
NEXT_PUBLIC_MAP_PROVIDER=amap
# 高德地图 JS API Key（用于地图显示，类型：Web端(JS API)）
NEXT_PUBLIC_AMAP_API_KEY=
# 高德地图 Web 服务 Key（用于地理编码，类型：Web服务，可选，如果不配置则使用上面的 KEY）
NEXT_PUBLIC_AMAP_WEB_SERVICE_KEY=
NEXT_PUBLIC_SPEECH_PROVIDER=xfyun
# Supabase 配置（必需）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side keys (never commit real values)
LLM_PROVIDER=aliyun-bailian
LLM_API_KEY=


